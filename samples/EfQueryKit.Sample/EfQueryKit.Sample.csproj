<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      The samples are a demo, not a compatibility matrix: pinning a single framework
      here (and clearing the inherited set, which `dotnet run` treats as multi-targeted
      even when it holds one entry) keeps running them a plain `dotnet run`.
    -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/EfQueryKit/EfQueryKit.csproj" />
  </ItemGroup>

</Project>
